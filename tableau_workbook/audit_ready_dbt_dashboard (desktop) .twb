      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.01pswnl1iyd3z310jfoss18pq67n].[ctd:product_id:qk]&quot;' value='SKUs' />
