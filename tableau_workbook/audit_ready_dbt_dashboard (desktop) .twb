          <alias key='&quot;[federated.01pswnl1iyd3z310jfoss18pq67n].[sum:ending_gross_inv_value:qk]&quot;' value='$ Value' />
        </aliases>
      </column>
      <column caption='Fiscal Year Matches Parameter' datatype='boolean' name='[Calculation_0900592148865027]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[fiscal_year] = [Parameters].[Parameter 0900592147755008]' />
      </column>
      <column caption='Current Year Avg DOH' datatype='real' name='[Calculation_0900592153731080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : AVG(IF [fiscal_year] = [Parameters].[Parameter 0900592147755008] THEN [avg_days_on_hand_at_year_end] END)}' />
      </column>
      <column caption='Prior Year Avg DOH' datatype='real' name='[Calculation_0900592153825289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : AVG(IF [fiscal_year] = str(int([Parameters].[Parameter 0900592147755008]) - 1) THEN [avg_days_on_hand_at_year_end] END)}' />
      </column>
      <column caption='Reporting Year Turnover' datatype='real' name='[Calculation_0900592156114954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : AVG(IF [fiscal_year] = [Parameters].[Parameter 0900592147755008] THEN [inventory_turnover_ratio] END)}' />
      </column>
      <column caption='Prior Fiscal Year Label' datatype='string' name='[Calculation_0900592156192779]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;FY&quot; + STR(int([Parameters].[Parameter 0900592147755008]) - 1)' />
      </column>
      <column caption='Inventory 365+ Value Rate' datatype='real' name='[Calculation_0900592158507021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_0900592158691342] = &quot;365+&quot; THEN [ending_gross_inv_value] ELSE 0 END)&#10;  / SUM([ending_gross_inv_value])' />
      </column>
      <column caption='Days on Hand Bucket' datatype='string' name='[Calculation_0900592158691342]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [avg_days_on_hand_at_year_end] &lt;= 90 THEN &quot;0-90&quot;&#10;ELSEIF [avg_days_on_hand_at_year_end] &lt;= 180 THEN &quot;91-180&quot;&#10;ELSEIF [avg_days_on_hand_at_year_end] &lt;= 365 THEN &quot;181-365&quot;&#10;ELSE &quot;365+&quot;&#10;END' />
      </column>
      <column caption='Ending Value in 365+ Bucket' datatype='real' name='[Calculation_0900592158797839]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_0900592158691342] = &quot;365+&quot; THEN [ending_gross_inv_value] END)' />
      </column>
      <column caption='Reporting Fiscal Year Label' datatype='string' name='[Calculation_0900592159424528]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;FY&quot; + STR([Parameters].[Parameter 0900592147755008])' />
      </column>
      <column caption='Total Product Years' datatype='integer' name='[Calculation_0900592164503569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([fiscal_year])' />
      </column>
      <column caption='Materiality Breach Count' datatype='integer' name='[Calculation_0900592164655122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ABS([audit_check_diff]) &gt; [materiality_threshold] THEN 1 ELSE 0 END' />
      </column>
      <column caption='Last 5 Fiscal Years' datatype='boolean' name='[Calculation_0900592216084500]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='INT([fiscal_year]) &gt;= INT([Parameters].[Parameter 0900592147755008]) - 4&#10;  AND INT([fiscal_year]) &lt;= INT([Parameters].[Parameter 0900592147755008])' />
      </column>
