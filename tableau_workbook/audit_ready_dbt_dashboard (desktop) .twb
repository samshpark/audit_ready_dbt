    <worksheet name='Highest-Risk SKUs'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='12'>Top 5 &lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontalignment='2' fontsize='8'>* Min. 15 units sold · not affected by the Order Date filter (all-time)</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='refund_reconciliation &amp; order_item_revenue' name='federated.0yttnfr1pupr29195vfvt1yin546' />
          </datasources>
          <datasource-dependencies datasource='federated.0yttnfr1pupr29195vfvt1yin546'>
            <column caption='PRODUCT RETURN RATE' datatype='real' name='[Calculation_6458416933658638]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [order_item_status] = &quot;returned&quot; THEN [order_item_id] END)&#10;  /&#10;  COUNTD([order_item_id])' />
            </column>
            <column caption='Units' datatype='string' name='[Calculation_6458417016762390]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(COUNTD(IF [order_item_status]=&quot;returned&quot; THEN [order_item_id] END))&#10;  + &quot; / &quot; +&#10;  STR(COUNTD([order_item_id]))' />
            </column>
            <column caption='Return Risk Tier' datatype='string' name='[Calculation_6458417016889368]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6458416933658638] &gt;= 0.25 THEN &quot;Critical&quot;&#10;  ELSEIF [Calculation_6458416933658638] &gt;= 0.15 THEN &quot;Warning&quot;&#10;  ELSE &quot;Normal&quot;&#10;  END' />
            </column>
            <column caption='Product Volume OK' datatype='boolean' name='[Calculation_6458417017917465]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED [product_id] : COUNTD([order_item_id])} &gt;= 15' />
            </column>
            <column caption='&apos;Rate&apos;' datatype='string' name='[Calculation_6458417021112347]' role='dimension' type='nominal' user:unnamed='Highest-Risk SKUs'>
              <calculation class='tableau' formula='&apos;Rate&apos;' />
            </column>
            <column-instance column='[Calculation_6458417017917465]' derivation='None' name='[none:Calculation_6458417017917465:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6458417021112347]' derivation='None' name='[none:Calculation_6458417021112347:nk]' pivot='key' type='nominal' />
