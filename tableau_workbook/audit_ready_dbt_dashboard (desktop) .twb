      <table>
        <view>
          <datasources>
            <datasource caption='order_reconciliation' name='federated.0g35shz0raashl1203xlz1u186fr' />
          </datasources>
          <datasource-dependencies datasource='federated.0g35shz0raashl1203xlz1u186fr'>
            <column caption='Total Orders' datatype='integer' name='[Calculation_5375878622048256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([order_id])' />
            </column>
            <column caption='Status Bar Category' datatype='string' name='[Calculation_5375878637559822]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [order_status_recon_detail]&#10;      WHEN &quot;INTEGRITY VERIFIED&quot; THEN &quot;Exact Match&quot;&#10;      WHEN &quot;VARIANCE DETECTED - UNEXPLAINED&quot; THEN &quot;Unexplained&quot;&#10;      ELSE &quot;Mixed Fulfillment&quot;&#10;  END' />
            </column>
            <column caption='Status Stat Text' datatype='string' name='[Calculation_5375878637764625]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(INT({FIXED : COUNTD(IF [order_status_recon_detail] = &quot;INTEGRITY VERIFIED&quot; THEN [order_id] END)})) + &quot; exact · &quot; +&#10;  STR(INT({FIXED : COUNTD(IF [order_status_recon_detail] IN (&quot;MIXED FULFILLMENT - PARTIAL REFUND&quot;, &quot;MIXED FULFILLMENT - PARTIAL SHIPMENT&quot;)&#10;  THEN [order_id] END)})) + &quot; mixed fulfillment · &quot; +&#10;  STR(INT({FIXED : COUNTD(IF [order_status_recon_detail] = &quot;VARIANCE DETECTED - UNEXPLAINED&quot; THEN [order_id] END)})) + &quot; unexplained&quot;' />
            </column>
            <column-instance column='[Calculation_5375878637764625]' derivation='Attribute' name='[attr:Calculation_5375878637764625:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5375878637559822]' derivation='None' name='[none:Calculation_5375878637559822:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5375878637764625]' derivation='None' name='[none:Calculation_5375878637764625:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_at]' derivation='None' name='[none:order_at:qk]' pivot='key' type='quantitative' />
            <column caption='Order At' datatype='date' datatype-customized='true' name='[order_at]' role='dimension' type='ordinal' />
            <column caption='Order Id' datatype='integer' name='[order_id]' role='dimension' type='ordinal' />
            <column caption='Order Status Recon Detail' datatype='string' name='[order_status_recon_detail]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5375878622048256]' derivation='User' name='[usr:Calculation_5375878622048256:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.0g35shz0raashl1203xlz1u186fr].[none:Calculation_5375878637559822:nk]' direction='ASC'>
