            <column caption='Reporting Fiscal Year' datatype='string' datatype-customized='true' name='[Parameter 0900592147755008]' param-domain-type='list' role='measure' source-field='[federated.01pswnl1iyd3z310jfoss18pq67n].[fiscal_year]' type='nominal' value='&quot;2026&quot;'>
