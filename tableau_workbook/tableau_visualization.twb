            </column>
            <column caption='Never Sold 2020 Count' datatype='integer' name='[Calculation_0900592221507608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_unsold] AND [received_fiscal_year] = 2020 THEN [inventory_item_id] END)' />
