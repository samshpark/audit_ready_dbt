      <aliases enabled='yes' />
      <column caption='Total Orders' datatype='integer' name='[Calculation_5375878622048256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Reconciled Orders' datatype='integer' name='[Calculation_5375878622113793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_reconciliation] = &quot;RECONCILIATION SUCCESSFUL&quot; THEN [order_id] END)' />
      </column>
      <column caption='Mixed Fulfillment Orders' datatype='integer' name='[Calculation_5375878622171138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_status_recon_detail] IN (&#10;      &quot;MIXED FULFILLMENT - PARTIAL REFUND&quot;,&#10;      &quot;MIXED FULFILLMENT - PARTIAL SHIPMENT&quot;&#10;  ) THEN [order_id] END)' />
      </column>
      <column caption='Unexplained Reconciliation Exceptions' datatype='integer' name='[Calculation_5375878622220291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF&#10;      [order_reconciliation] &lt;&gt; &quot;RECONCILIATION SUCCESSFUL&quot;&#10;      OR [order_item_count_recon] = &quot;VARIANCE DETECTED&quot;&#10;      OR [order_status_recon_detail] = &quot;VARIANCE DETECTED - UNEXPLAINED&quot;&#10;      THEN [order_id]&#10;  END)' />
      </column>
      <column caption='Unexplained Exceptions Flag' datatype='integer' name='[Calculation_5375878622347268]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_5375878622220291] = 0, 1, 0)' />
      </column>
      <column caption='Reconciliation Caption' datatype='string' name='[Calculation_5375878622425093]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(INT([Calculation_5375878622113793])) + &quot; of &quot; + STR(INT([Calculation_5375878622048256])) + &quot; orders reconcile&quot; +&#10;  IF [Calculation_5375878622171138] &gt; 0 THEN&#10;      &quot; — including &quot; + STR(INT([Calculation_5375878622171138])) + &quot; mixed-fulfillment orders fully explained by partial refunds&quot;&#10;  ELSE &quot;&quot; END' />
      </column>
      <column caption='Existence Match Rate' datatype='real' name='[Calculation_5375878625464327]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_reconciliation] = &quot;RECONCILIATION SUCCESSFUL&quot; THEN [order_id] END)&#10;  / COUNTD([order_id])' />
      </column>
      <column caption='Existence Status Flag' datatype='integer' name='[Calculation_5375878625558536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_5375878625464327] = 1, 1, 0)' />
      </column>
      <column caption='Item Count Match Rate' datatype='real' name='[Calculation_5375878626803721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_item_count_recon] = &quot;INTEGRITY VERIFIED&quot; THEN [order_id] END)&#10;  / COUNTD([order_id])' />
      </column>
      <column caption='Item Count Status Flag' datatype='integer' name='[Calculation_5375878626869258]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_5375878626803721] = 1, 1, 0)' />
      </column>
      <column caption='Status Exact Match Rate' datatype='real' name='[Calculation_5375878629060619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_status_recon_detail] = &quot;INTEGRITY VERIFIED&quot; THEN [order_id] END)&#10;  / COUNTD([order_id])' />
      </column>
      <column caption='Status Mixed Fulfillment Rate' datatype='real' name='[Calculation_5375878629576716]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_status_recon_detail] IN (&#10;      &quot;MIXED FULFILLMENT - PARTIAL REFUND&quot;,&#10;      &quot;MIXED FULFILLMENT - PARTIAL SHIPMENT&quot;&#10;  ) THEN [order_id] END)&#10;  / COUNTD([order_id])' />
      </column>
      <column caption='Status Bar Category' datatype='string' name='[Calculation_5375878637559822]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [order_status_recon_detail]&#10;      WHEN &quot;INTEGRITY VERIFIED&quot; THEN &quot;Exact Match&quot;&#10;      WHEN &quot;VARIANCE DETECTED - UNEXPLAINED&quot; THEN &quot;Unexplained&quot;&#10;      ELSE &quot;Mixed Fulfillment&quot;&#10;  END' />
      </column>
      <column caption='Existence Stat Text' datatype='string' name='[Calculation_5375878637617167]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT({FIXED : COUNTD(IF [order_reconciliation] = &quot;RECONCILIATION SUCCESSFUL&quot; THEN [order_id] END)})) + &quot; matched · &quot; +&#10;  STR(INT({FIXED : COUNTD(IF [order_reconciliation] &lt;&gt; &quot;RECONCILIATION SUCCESSFUL&quot; THEN [order_id] END)})) + &quot; orphaned&quot;' />
      </column>
      <column caption='Item Count Stat Text' datatype='string' name='[Calculation_5375878637670416]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT({FIXED : COUNTD(IF [order_item_count_recon] = &quot;INTEGRITY VERIFIED&quot; THEN [order_id] END)})) + &quot; verified · &quot; +&#10;  STR(INT({FIXED : COUNTD(IF [order_item_count_recon] = &quot;VARIANCE DETECTED&quot; THEN [order_id] END)})) + &quot; variance&quot;' />
      </column>
      <column caption='Status Stat Text' datatype='string' name='[Calculation_5375878637764625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(INT({FIXED : COUNTD(IF [order_status_recon_detail] = &quot;INTEGRITY VERIFIED&quot; THEN [order_id] END)})) + &quot; exact · &quot; +&#10;  STR(INT({FIXED : COUNTD(IF [order_status_recon_detail] IN (&quot;MIXED FULFILLMENT - PARTIAL REFUND&quot;, &quot;MIXED FULFILLMENT - PARTIAL SHIPMENT&quot;)&#10;  THEN [order_id] END)})) + &quot; mixed fulfillment · &quot; +&#10;  STR(INT({FIXED : COUNTD(IF [order_status_recon_detail] = &quot;VARIANCE DETECTED - UNEXPLAINED&quot; THEN [order_id] END)})) + &quot; unexplained&quot;' />
      </column>
      <column caption='Recon Order Month' datatype='date' datatype-customized='true' name='[Calculation_5375878651056147]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [order_at]))' />
      </column>
      <column caption='Latest Recon Order Month' datatype='date' name='[Calculation_5375878651154452]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED : MAX([Calculation_5375878651056147])}' />
      </column>
      <column caption='Monthly Mixed Fulfillment Rate' datatype='real' name='[Calculation_5375878651207701]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_5375878651056147] :&#10;      COUNTD(IF [order_status_recon_detail] IN (&quot;MIXED FULFILLMENT - PARTIAL REFUND&quot;, &quot;MIXED FULFILLMENT - PARTIAL SHIPMENT&quot;) THEN [order_id]&#10;  END)&#10;    }&#10;    /&#10;  { FIXED [Calculation_5375878651056147] : COUNTD([order_id]) }' />
      </column>
      <column caption='Latest Month Mixed Fulfillment Rate' datatype='real' name='[Calculation_5375878651273238]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX(IF [Calculation_5375878651056147] = [Calculation_5375878651154452] THEN [Calculation_5375878651207701] END) }' />
      </column>
      <column caption='Last Point Marker' datatype='real' name='[Calculation_5375878651330583]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_5375878651056147] = [Calculation_5375878651154452] THEN [Calculation_5375878651207701] END' />
      </column>
      <column caption='Report Updated Date' datatype='date' name='[Calculation_5375878655922200]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([order_at])' />
      </column>
      <column caption='Show In Ledger' datatype='boolean' name='[Calculation_6043694540414978]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[ColorCenter]&#10;      WHEN &quot;Unexplained Status Mismatch&quot; THEN [order_status_recon_detail] = &quot;VARIANCE DETECTED - UNEXPLAINED&quot;&#10;      WHEN &quot;Mixed Fulfillment&quot; THEN STARTSWITH([order_status_recon_detail], &quot;MIXED FULFILLMENT&quot;)&#10;      WHEN &quot;Item Count Variance&quot; THEN [order_item_count_recon] = &quot;VARIANCE DETECTED&quot;&#10;      WHEN &quot;Existence&quot; THEN [order_reconciliation] &lt;&gt; &quot;RECONCILIATION SUCCESSFUL&quot;&#10;  END' />
      </column>
      <column caption='Ledger Result' datatype='string' name='[Calculation_6043694540558339]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [order_status_recon_detail]&#10;      WHEN &quot;INTEGRITY VERIFIED&quot; THEN &quot;EXACT MATCH&quot;&#10;      WHEN &quot;VARIANCE DETECTED - UNEXPLAINED&quot; THEN &quot;UNEXPLAINED&quot;&#10;      ELSE &quot;MIXED FULFILLMENT&quot;&#10;  END' />
      </column>
      <column caption='Ledger Banner' datatype='string' name='[Calculation_6043694541586438]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[ColorCenter] = &quot;Unexplained Status Mismatch&quot;&#10;      AND {FIXED : COUNTD(IF [order_status_recon_detail] = &quot;VARIANCE DETECTED - UNEXPLAINED&quot; THEN [order_id] END)} = 0&#10;      THEN &quot;0 unexplained reconciliation exceptions this period — Mixed Fulfillment (informational) shown below instead&quot;&#10;  ELSEIF [Parameters].[ColorCenter] = &quot;Item Count Variance&quot;&#10;      AND {FIXED : COUNTD(IF [order_item_count_recon] = &quot;VARIANCE DETECTED&quot; THEN [order_id] END)} = 0&#10;      THEN &quot;0 item-count variances this period&quot;&#10;  ELSEIF [Parameters].[ColorCenter] = &quot;Existence&quot;&#10;      AND {FIXED : COUNTD(IF [order_reconciliation] &lt;&gt; &quot;RECONCILIATION SUCCESSFUL&quot; THEN [order_id] END)} = 0&#10;      THEN &quot;0 existence errors this period&quot;&#10;  ELSE &quot;&quot;&#10;  END' />
      </column>
