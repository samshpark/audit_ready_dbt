      <aliases enabled='yes' />
      <column caption='Report Updated Date' datatype='date' name='[Calculation_1799713972637696]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([created_at])' />
      </column>
      <column caption='Order Date' datatype='datetime' default-format='*mmm yyyy' name='[Calculation_2276422412976128]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;, [created_at])' />
      </column>
      <column caption='Band Lower' datatype='real' name='[Calculation_2276422777118728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MIN(SUM([recognized_revenue]) / SUM([gross_revenue]), FIRST(), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Band Upper' datatype='real' name='[Calculation_2276422777180169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX(SUM([recognized_revenue]) / SUM([gross_revenue]), FIRST(), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Recognition Rate' datatype='real' name='[Calculation_2276422777421835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([recognized_revenue])/SUM([gross_revenue])' />
      </column>
      <column caption='Last Flag' datatype='string' name='[Calculation_2276422777495564]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF LAST() = 0 THEN&#10;      IF [Calculation_2276422777421835] &lt; WINDOW_MIN(SUM([recognized_revenue])/SUM([gross_revenue]),&#10;  FIRST(), -1)&#10;      OR [Calculation_2276422777421835] &gt; WINDOW_MAX(SUM([recognized_revenue])/SUM([gross_revenue]),&#10;  FIRST(), -1)&#10;      THEN &quot;Outside Band&quot;&#10;      ELSE &quot;Normal&quot;&#10;      END&#10;  END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Point Size' datatype='integer' name='[Calculation_2276422779662349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF LAST() = 0 THEN 1 ELSE 0 END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cutoff Risk Orders' datatype='integer' name='[Calculation_4176104216092672]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [cutoff_status] = &quot;POTENTIAL CUT-OFF RISK&quot; THEN [order_id] END)' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_4176104216141825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Cutoff Risk Rate' datatype='real' name='[Calculation_4176104216215554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_4176104216092672] / [Calculation_4176104216141825]' />
      </column>
      <column caption='Order Month' datatype='datetime' name='[Calculation_4176104223514627]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [created_at])' />
      </column>
      <column caption='Monthly Cutoff Risk Rate' datatype='real' name='[Calculation_4176104223604740]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_4176104223514627] :&#10;      COUNTD(IF [cutoff_status] = &quot;POTENTIAL CUT-OFF RISK&quot; THEN [order_id] END)&#10;    }&#10;    /&#10;  { FIXED [Calculation_4176104223514627] :&#10;      COUNTD(IF [cutoff_status] &lt;&gt; &quot;SHIPPING_PENDING&quot; THEN [order_id] END)&#10;    }' />
      </column>
      <column caption='Latest Order Month' datatype='datetime' name='[Calculation_4176104223719429]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX(&#10;      IF [Calculation_4176104250069011] &gt;= DATEADD(&apos;day&apos;, -1, DATEADD(&apos;month&apos;, 1, [Calculation_4176104223514627]))&#10;      THEN [Calculation_4176104223514627]&#10;      END&#10;    ) }' />
      </column>
      <column caption='Months Back' datatype='integer' name='[Calculation_4176104223768582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [Calculation_4176104223514627], [Calculation_4176104223719429])' />
      </column>
      <column caption='Trailing Risk Rate Min (6mo)' datatype='real' name='[Calculation_4176104223830023]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MIN(IF [Calculation_4176104223768582] &gt;= 1 AND [Calculation_4176104223768582] &lt; 7 THEN [Calculation_4176104223604740] END) }' />
      </column>
      <column caption='Trailing Risk Rate Max (6mo)' datatype='real' name='[Calculation_4176104223936520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX(IF [Calculation_4176104223768582] &gt;= 1 AND [Calculation_4176104223768582] &lt; 7 THEN [Calculation_4176104223604740] END) }' />
      </column>
      <column caption='Cutoff Risk Trend Caption' datatype='string' name='[Calculation_4176104224063497]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4176104223830023] &gt;= 0.03 AND [Calculation_4176104223936520] &lt;= 0.07 THEN&#10;      &quot;Steady in the &quot; + STR(INT(ROUND([Calculation_4176104223830023]*100,0)))&#10;      + &quot;–&quot; + STR(INT(ROUND([Calculation_4176104223936520]*100,0))) + &quot;%/mo range&quot;&#10;  ELSEIF [Calculation_4176104223936520] &gt; 0.07 THEN&#10;      &quot;Elevated — up to &quot; + STR(INT(ROUND([Calculation_4176104223936520]*100,0))) + &quot;%/mo recently&quot;&#10;  ELSEIF [Calculation_4176104223830023] &lt; 0.03 THEN&#10;      &quot;Improved — down to &quot; + STR(INT(ROUND([Calculation_4176104223830023]*100,0))) + &quot;%/mo recently&quot;&#10;  ELSE&#10;      &quot;Trend unavailable&quot;&#10;  END' />
      </column>
      <column caption='Gap' datatype='integer' name='[Calculation_4176104226209802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [created_at], [shipped_at])' />
      </column>
      <column caption='Integrity Status' datatype='string' name='[Calculation_4176104229261323]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF(ZN(COUNTD(IF [data_integrity_status] &lt;&gt; &quot;MATCHED&quot; THEN [order_id] END)) = 0,&#10;      &quot;Healthy&quot;, &quot;Exceptions Found&quot;)' />
      </column>
      <column caption='Integrity Badge Text' datatype='string' name='[Calculation_4176104231612428]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4176104229261323] = &quot;Healthy&quot; THEN &quot;Master = Sub-ledger&quot;&#10;  ELSE &quot;Master ≠ Sub-ledger — review needed&quot; END' />
      </column>
      <column caption='Integrity Exceptions Flag' datatype='integer' name='[Calculation_4176104233639949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF(ZN(COUNTD(IF [data_integrity_status] &lt;&gt; &quot;MATCHED&quot; THEN [order_id] END)) = 0, 1, 0)' />
      </column>
      <column caption='Is Latest Closed Month' datatype='boolean' name='[Calculation_4176104247308306]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_4176104223514627] = [Calculation_4176104223719429]' />
      </column>
      <column caption='Max Filtered Date' datatype='date' name='[Calculation_4176104250069011]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX([created_at]) }' />
      </column>
