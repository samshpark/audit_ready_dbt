            <column caption='Order Id (Order Item Revenue.Csv)' datatype='integer' name='[order_id (order_item_revenue.csv)]' role='dimension' type='ordinal' />
            <column caption='Order Item Id' datatype='integer' name='[order_item_id]' role='dimension' type='ordinal' />
            <column caption='Shipped At' datatype='datetime' name='[shipped_at]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_6458417030709283]' derivation='User' name='[usr:Calculation_6458417030709283:qk]' pivot='key' type='quantitative' />
