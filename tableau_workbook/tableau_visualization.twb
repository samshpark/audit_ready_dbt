      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0yttnfr1pupr29195vfvt1yin546].[ctd:order_id:qk]&quot;' value='Orders' />
          <alias key='&quot;[federated.0yttnfr1pupr29195vfvt1yin546].[pcto:ctd:order_id:qk]&quot;' value='% Orders' />
          <alias key='&quot;[federated.0yttnfr1pupr29195vfvt1yin546].[sum:gross_revenue:qk]&quot;' value='Gross' />
          <alias key='&quot;[federated.0yttnfr1pupr29195vfvt1yin546].[sum:refund_amount:qk]&quot;' value='Refunded' />
        </aliases>
      </column>
      <column caption='Report Updated Date' datatype='date' name='[Calculation_6458416897388545]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX([order_date])' />
      </column>
      <column caption='Refund Order Id' datatype='integer' name='[Calculation_6458416901586947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [refund_type] &lt;&gt; &quot;NO REFUND&quot; THEN [order_id] END' />
      </column>
      <column caption='Refund Month' datatype='date' datatype-customized='true' default-format='*mmm yyyy' name='[Calculation_6458416915537932]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATETRUNC(&apos;month&apos;, [order_date]))' />
      </column>
      <column caption='Overall Refund Rate' datatype='real' name='[Calculation_6458416915595277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([refund_amount]) / SUM([gross_revenue])' />
      </column>
      <column caption='PRODUCT RETURN RATE' datatype='real' name='[Calculation_6458416933658638]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_item_status] = &quot;returned&quot; THEN [order_item_id] END)&#10;  /&#10;  COUNTD([order_item_id])' />
      </column>
      <column caption='Return Order Id' datatype='integer' name='[Calculation_6458416934166543]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [order_item_status] = &quot;returned&quot; THEN [order_item_id] END' />
      </column>
      <column caption='Has Shipped' datatype='boolean' name='[Calculation_6458416934686736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([shipped_at])' />
      </column>
      <column caption='Fulfillment Lead Time (days)' datatype='integer' name='[Calculation_6458416934809617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [created_at], [shipped_at])' />
      </column>
      <column caption='Negative Lead Time Rate' datatype='real' name='[Calculation_6458416935489554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [shipped_at] &lt; [created_at] THEN [order_item_id] END)&#10;  /&#10;  COUNTD([order_item_id])' />
      </column>
      <column caption='Units' datatype='string' name='[Calculation_6458417016762390]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(COUNTD(IF [order_item_status]=&quot;returned&quot; THEN [order_item_id] END))&#10;  + &quot; / &quot; +&#10;  STR(COUNTD([order_item_id]))' />
      </column>
      <column caption='Return Risk Tier' datatype='string' name='[Calculation_6458417016889368]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_6458416933658638] &gt;= 0.25 THEN &quot;Critical&quot;&#10;  ELSEIF [Calculation_6458416933658638] &gt;= 0.15 THEN &quot;Warning&quot;&#10;  ELSE &quot;Normal&quot;&#10;  END' />
      </column>
      <column caption='Product Volume OK' datatype='boolean' name='[Calculation_6458417017917465]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [product_id] : COUNTD([order_item_id])} &gt;= 15' />
      </column>
      <column caption='Lead Time Bucket' datatype='string' name='[Calculation_6458417026043933]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [shipped_at] &lt; [created_at] THEN &quot;&lt; 0 (anomaly)&quot;&#10;  ELSEIF DATEDIFF(&apos;day&apos;, [created_at], [shipped_at]) &lt;= 1 THEN &quot;0-1&quot;&#10;  ELSEIF DATEDIFF(&apos;day&apos;, [created_at], [shipped_at]) &lt;= 2 THEN &quot;1-2&quot;&#10;  ELSEIF DATEDIFF(&apos;day&apos;, [created_at], [shipped_at]) &lt;= 3 THEN &quot;2-3&quot;&#10;  ELSEIF DATEDIFF(&apos;day&apos;, [created_at], [shipped_at]) &lt;= 5 THEN &quot;3-5&quot;&#10;  ELSEIF DATEDIFF(&apos;day&apos;, [created_at], [shipped_at]) &lt;= 7 THEN &quot;5-7&quot;&#10;  ELSE &quot;7+&quot;&#10;  END' />
      </column>
      <column caption='Lead Time Bucket Sort' datatype='integer' name='[Calculation_6458417026117662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [shipped_at] &lt; [created_at] THEN 0&#10;  ELSEIF DATEDIFF(&apos;day&apos;, [created_at], [shipped_at]) &lt;= 1 THEN 1&#10;  ELSEIF DATEDIFF(&apos;day&apos;, [created_at], [shipped_at]) &lt;= 2 THEN 2&#10;  ELSEIF DATEDIFF(&apos;day&apos;, [created_at], [shipped_at]) &lt;= 3 THEN 3&#10;  ELSEIF DATEDIFF(&apos;day&apos;, [created_at], [shipped_at]) &lt;= 5 THEN 4&#10;  ELSEIF DATEDIFF(&apos;day&apos;, [created_at], [shipped_at]) &lt;= 7 THEN 5&#10;  ELSE 6&#10;  END' />
      </column>
      <column caption='Negative Lead Time Count' datatype='integer' name='[Calculation_6458417030709283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [shipped_at] &lt; [created_at] THEN [order_item_id] END)' />
      </column>
      <column caption='Store Return Rate' datatype='real' name='[Calculation_6458417040093222]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_item_status] = &quot;returned&quot; THEN [order_item_id] END)&#10;      / COUNTD([order_item_id])' />
