    <worksheet name='Unexplained Reconciliation Exceptions'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='false' fontsize='10'><![CDATA[<[federated.0g35shz0raashl1203xlz1u186fr].[ctd:order_id:qk]> of <[federated.0g35shz0raashl1203xlz1u186fr].[ctd:order_id:qk]> orders reconcile ]]></run>
            <run>Æ&#10;</run>
            <run bold='false' fontsize='10'><![CDATA[— including <[federated.0g35shz0raashl1203xlz1u186fr].[usr:Calculation_5375878622171138:qk]> mixed-fulfillment orders fully explained by partial refunds]]></run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='order_reconciliation' name='federated.0g35shz0raashl1203xlz1u186fr' />
          </datasources>
          <datasource-dependencies datasource='federated.0g35shz0raashl1203xlz1u186fr'>
            <column caption='Mixed Fulfillment Orders' datatype='integer' name='[Calculation_5375878622171138]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [order_status_recon_detail] IN (&#10;      &quot;MIXED FULFILLMENT - PARTIAL REFUND&quot;,&#10;      &quot;MIXED FULFILLMENT - PARTIAL SHIPMENT&quot;&#10;  ) THEN [order_id] END)' />
            </column>
            <column caption='Unexplained Reconciliation Exceptions' datatype='integer' name='[Calculation_5375878622220291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF&#10;      [order_reconciliation] &lt;&gt; &quot;RECONCILIATION SUCCESSFUL&quot;&#10;      OR [order_item_count_recon] = &quot;VARIANCE DETECTED&quot;&#10;      OR [order_status_recon_detail] = &quot;VARIANCE DETECTED - UNEXPLAINED&quot;&#10;      THEN [order_id]&#10;  END)' />
            </column>
            <column caption='Unexplained Exceptions Flag' datatype='integer' name='[Calculation_5375878622347268]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IIF([Calculation_5375878622220291] = 0, 1, 0)' />
            </column>
            <column-instance column='[order_id]' derivation='CountD' name='[ctd:order_id:qk]' pivot='key' type='quantitative' />
            <column-instance column='[order_at]' derivation='None' name='[none:order_at:qk]' pivot='key' type='quantitative' />
            <column caption='Order At' datatype='date' datatype-customized='true' name='[order_at]' role='dimension' type='ordinal' />
            <column caption='Order Id' datatype='integer' name='[order_id]' role='dimension' type='ordinal' />
            <column caption='Order Item Count Recon' datatype='string' name='[order_item_count_recon]' role='dimension' type='nominal' />
            <column caption='Order Reconciliation' datatype='string' name='[order_reconciliation]' role='dimension' type='nominal' />
            <column caption='Order Status Recon Detail' datatype='string' name='[order_status_recon_detail]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5375878622171138]' derivation='User' name='[usr:Calculation_5375878622171138:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5375878622220291]' derivation='User' name='[usr:Calculation_5375878622220291:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5375878622347268]' derivation='User' name='[usr:Calculation_5375878622347268:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.0g35shz0raashl1203xlz1u186fr].[none:order_at:qk]' context='true' filter-group='6' included-values='in-range'>
