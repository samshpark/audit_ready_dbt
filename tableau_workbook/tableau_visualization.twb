            <run bold='false' fontalignment='1' fontsize='10'>Master = Sub-ledger</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='revenue' name='federated.0ev9cin1e0v7ra1azulgu009xb8j' />
