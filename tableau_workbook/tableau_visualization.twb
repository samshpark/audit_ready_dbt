              <calculation class='tableau' formula='[fiscal_year] = [Parameters].[Parameter 0900592147755008]' />
            </column>
            <column caption='Inventory 365+ Value Rate' datatype='real' name='[Calculation_0900592158507021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_0900592158691342] = &quot;365+&quot; THEN [ending_gross_inv_value] ELSE 0 END)&#10;  / SUM([ending_gross_inv_value])' />
            </column>
            <column caption='Days on Hand Bucket' datatype='string' name='[Calculation_0900592158691342]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [avg_days_on_hand_at_year_end] &lt;= 90 THEN &quot;0-90&quot;&#10;ELSEIF [avg_days_on_hand_at_year_end] &lt;= 180 THEN &quot;91-180&quot;&#10;ELSEIF [avg_days_on_hand_at_year_end] &lt;= 365 THEN &quot;181-365&quot;&#10;ELSE &quot;365+&quot;&#10;END' />
            </column>
            <column caption='Ending Value in 365+ Bucket' datatype='real' name='[Calculation_0900592158797839]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_0900592158691342] = &quot;365+&quot; THEN [ending_gross_inv_value] END)' />
            </column>
            <column caption='Reporting Fiscal Year Label' datatype='string' name='[Calculation_0900592159424528]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;FY&quot; + STR([Parameters].[Parameter 0900592147755008])' />
