    <worksheet name='Recognition Rate, by Month'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#666666' fontname='Tableau Semibold' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='revenue' name='federated.0ev9cin1e0v7ra1azulgu009xb8j' />
          </datasources>
          <datasource-dependencies datasource='federated.0ev9cin1e0v7ra1azulgu009xb8j'>
            <column caption='Order Date' datatype='datetime' default-format='*mmm yyyy' name='[Calculation_2276422412976128]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;day&apos;, [created_at])' />
            </column>
            <column caption='Recognition Rate' datatype='real' name='[Calculation_2276422777421835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([recognized_revenue])/SUM([gross_revenue])' />
            </column>
            <column caption='Last Flag' datatype='string' name='[Calculation_2276422777495564]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF LAST() = 0 THEN&#10;      IF [Calculation_2276422777421835] &lt; WINDOW_MIN(SUM([recognized_revenue])/SUM([gross_revenue]),&#10;  FIRST(), -1)&#10;      OR [Calculation_2276422777421835] &gt; WINDOW_MAX(SUM([recognized_revenue])/SUM([gross_revenue]),&#10;  FIRST(), -1)&#10;      THEN &quot;Outside Band&quot;&#10;      ELSE &quot;Normal&quot;&#10;      END&#10;  END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Point Size' datatype='integer' name='[Calculation_2276422779662349]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF LAST() = 0 THEN 1 ELSE 0 END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Created At' datatype='date' datatype-customized='true' name='[created_at]' role='dimension' type='ordinal' />
            <column caption='Gross Revenue' datatype='real' name='[gross_revenue]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2276422412976128]' derivation='Max' name='[max:Calculation_2276422412976128:qk]' pivot='key' type='quantitative' />
