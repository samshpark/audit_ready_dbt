    <worksheet name='FULFILLMENT LEAD TIME'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontsize='10'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontalignment='1' fontcolor='#ae123a' fontsize='10'>&lt;</run>
            <run fontalignment='1' fontcolor='#ae123a' fontsize='10'>[federated.0yttnfr1pupr29195vfvt1yin546].[usr:Calculation_6458416935489554:qk]</run>
            <run fontalignment='1' fontcolor='#ae123a' fontsize='10'>&gt; of shipments show a negative lead time</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='refund_reconciliation &amp; order_item_revenue' name='federated.0yttnfr1pupr29195vfvt1yin546' />
          </datasources>
          <datasource-dependencies datasource='federated.0yttnfr1pupr29195vfvt1yin546'>
            <column caption='Has Shipped' datatype='boolean' name='[Calculation_6458416934686736]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([shipped_at])' />
            </column>
            <column caption='Fulfillment Lead Time (days)' datatype='integer' name='[Calculation_6458416934809617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [created_at], [shipped_at])' />
            </column>
            <column caption='Negative Lead Time Rate' datatype='real' name='[Calculation_6458416935489554]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [shipped_at] &lt; [created_at] THEN [order_item_id] END)&#10;  /&#10;  COUNTD([order_item_id])' />
            </column>
            <column-instance column='[Calculation_6458416934809617]' derivation='Avg' name='[avg:Calculation_6458416934809617:qk]' pivot='key' type='quantitative' />
            <column caption='Created At' datatype='datetime' name='[created_at]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_6458416934686736]' derivation='None' name='[none:Calculation_6458416934686736:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
            <column caption='Order Date' datatype='date' datatype-customized='true' name='[order_date]' role='dimension' type='ordinal' />
            <column caption='Order Item Id' datatype='integer' name='[order_item_id]' role='dimension' type='ordinal' />
            <column caption='Shipped At' datatype='datetime' name='[shipped_at]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_6458416935489554]' derivation='User' name='[usr:Calculation_6458416935489554:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0yttnfr1pupr29195vfvt1yin546].[none:Calculation_6458416934686736:nk]'>
            <groupfilter function='member' level='[none:Calculation_6458416934686736:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='quantitative' column='[federated.0yttnfr1pupr29195vfvt1yin546].[none:order_date:qk]' context='true' filter-group='7' included-values='in-range'>
            <min>#2025-07-01#</min>
            <max>#2026-06-30#</max>
          </filter>
